# Copy to .env and fill in. .env is git-ignored and never committed.
#
# Africa's Talking sandbox: https://account.africastalking.com/apps/sandbox/settings/key
# The sandbox sends to their simulator, not to real phones, and costs nothing.
AT_USERNAME=sandbox
AT_API_KEY=
# Leave AT_SENDER empty on the sandbox; a short code only applies to a paid account.
AT_SENDER=

# The phone number you open in the Africa's Talking simulator, in +2376... form.
# Seed this as the demo host so their SMS arrives in your simulator window.
KARIBU_HOST_PHONE=+237600000001

# Optional overrides
# KARIBU_MODEL=gemma3:1b
# KARIBU_WHISPER=small
