lidFill><a:srgbClr val="1C1A17"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>160 characters, not a screen</a:t></a:r><a:endParaRPr lang="en-US" sz="1500" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="4" name="Text 2"></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="4709160" y="1691640"/><a:ext cx="6858000" cy="777240"/></a:xfrm><a:prstGeom prst="rect"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" marL="0"><a:lnSpc><a:spcPts val="2000"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1350" dirty="0"><a:solidFill><a:srgbClr val="3D3832"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>Every question we ask the host is closed and every answer is one character. We lose choice and we gain a message that costs one segment and shows on any handset.</a:t></a:r><a:endParaRPr lang="en-US" sz="1350" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="5" name="Shape 3"></p:cNvPr><p:cNvSpPr/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="594360" y="2532888"/><a:ext cx="11000232" cy="0"/></a:xfrm><a:prstGeom prst="line"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln w="12700"><a:solidFill><a:srgbClr val="DFD9CE"/></a:solidFill><a:prstDash val="solid"/></a:ln></p:spPr></p:sp><p:sp><p:nvSpPr><p:cNvPr id="6" name="Text 4"></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="594360" y="2660904"/><a:ext cx="3931920" cy="640080"/></a:xfrm><a:prstGeom prst="rect"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" marL="0"><a:lnSpc><a:spcPts val="2100"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1500" b="1" dirty="0"><a:solidFill><a:srgbClr val="1C1A17"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>Rules, not a bigger model</a:t></a:r><a:endParaRPr lang="en-US" sz="1500" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="7" name="Text 5"></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="4709160" y="2624328"/><a:ext cx="6858000" cy="777240"/></a:xfrm><a:prstGeom prst="rect"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" marL="0"><a:lnSpc><a:spcPts val="2000"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1350" dirty="0"><a:solidFill><a:srgbClr val="3D3832"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>Rules do not generalise. Each language had to be written by hand. In exchange the dates are right and the answer comes back in a millisecond.</a:t></a:r><a:endParaRPr lang="en-US" sz="1350" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="8" name="Shape 6"></p:cNvPr><p:cNvSpPr/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="594360" y="3465576"/><a:ext cx="11000232" cy="0"/></a:xfrm><a:prstGeom prst="line"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln w="12700"><a:solidFill><a:srgbClr val="DFD9CE"/></a:solidFill><a:prstDash val="solid"/></a:ln></p:spPr></p:sp><p:sp><p:nvSpPr><p:cNvPr id="9" name="Text 7"></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="594360" y="3593592"/><a:ext cx="3931920" cy="640080"/></a:xfrm><a:prstGeom prst="rect"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" marL="0"><a:lnSpc><a:spcPts val="2100"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1500" b="1" dirty="0"><a:solidFill><a:srgbClr val="1C1A17"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>The host makes them wait</a:t></a:r><a:endParaRPr lang="en-US" sz="1500" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="10" name="Text 8"></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="4709160" y="3557016"/><a:ext cx="6858000" cy="777240"/></a:xfrm><a:prstGeom prst="rect"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" marL="0"><a:lnSpc><a:spcPts val="2000"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1350" dirty="0"><a:solidFill><a:srgbClr val="3D3832"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>Confirmation is not instant. The visitor is told to allow two hours, and the request expires after that so nobody is left hanging.</a:t></a:r><a:endParaRPr lang="en-US" sz="1350" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="11" name="Shape 9"></p:cNvPr><p:cNvSpPr/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="594360" y="4398264"/><a:ext cx="11000232" cy="0"/></a:xfrm><a:prstGeom prst="line"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln w="12700"><a:solidFill><a:srgbClr val="DFD9CE"/></a:solidFill><a:prstDash val="solid"/></a:ln></p:spPr></p:sp><p:sp><p:nvSpPr><p:cNvPr id="12" name="Text 10"></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="594360" y="4526280"/><a:ext cx="3931920" cy="640080"/></a:xfrm><a:prstGeom prst="rect"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" marL="0"><a:lnSpc><a:spcPts val="2100"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1500" b="1" dirty="0"><a:solidFill><a:srgbClr val="1C1A17"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>Three languages, not a hundred</a:t></a:r><a:endParaRPr lang="en-US" sz="1500" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="13" name="Text 11"></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="4709160" y="4489704"/><a:ext cx="6858000" cy="777240"/></a:xfrm><a:prstGeom prst="rect"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" marL="0"><a:lnSpc><a:spcPts val="2000"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1350" dirty="0"><a:solidFill><a:srgbClr val="3D3832"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>Korean, French and English are read by rule. A fourth language is a small table, not a retrained model.</a:t></a:r><a:endParaRPr lang="en-US" sz="1350" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="14" name="Shape 12"></p:cNvPr><p:cNvSpPr/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="594360" y="5330952"/><a:ext cx="11000232" cy="0"/></a:xfrm><a:prstGeom prst="line"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln w="12700"><a:solidFill><a:srgbClr val="DFD9CE"/></a:solidFill><a:prstDash val="solid"/></a:ln></p:spPr></p:sp><p:sp><p:nvSpPr><p:cNvPr id="15" name="Text 13"></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="594360" y="5458968"/><a:ext cx="3931920" cy="640080"/></a:xfrm><a:prstGeom prst="rect"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" marL="0"><a:lnSpc><a:spcPts val="2100"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1500" b="1" dirty="0"><a:solidFill><a:srgbClr val="1C1A17"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>No booking is final without a person</a:t></a:r><a:endParaRPr lang="en-US" sz="1500" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="16" name="Text 14"></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="4709160" y="5422392"/><a:ext cx="6858000" cy="777240"/></a:xfrm><a:prstGeom prst="rect"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" marL="0"><a:lnSpc><a:spcPts val="2000"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1350" dirty="0"><a:solidFill><a:srgbClr val="3D3832"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>The model can be wrong, so the host is the check. That is slower than confirming automatically, and it is the only version worth putting in front of a real guesthouse.</a:t></a:r><a:endParaRPr lang="en-US" sz="1350" dirty="0"/></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>